# Cloudflare credentials — only used for R2 image uploads (banner/champion
# photos). Database access goes through the wrangler.toml D1 binding instead,
# no token needed for that.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Admin console login (required — the admin console refuses all logins until this is set)
ADMIN_PASSWORD=change_me

# Signs/verifies session JWTs (required — no safe default; the code falls
# back to a hardcoded secret in source if this is unset, which is insecure
# for anything but local testing)
JWT_SECRET=change_me
